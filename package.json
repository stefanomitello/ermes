{
  "name": "ermes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter @ermes/backend dev",
    "dev:frontend": "pnpm --filter @ermes/frontend dev",
    "dev": "pnpm --parallel --filter @ermes/* dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1"
  }
}
